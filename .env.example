# ==============================================================================
# StressGuard AI 2.0 - Environment Variables Configuration Template
# DO NOT COMMIT REAL CREDENTIALS. Copy this file to .env for local environments.
# For cloud deployment (Render, Vercel, TiDB), configure these in your provider dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (TiDB Cloud Serverless / Aiven / MySQL 8.0)
# ------------------------------------------------------------------------------
# TiDB Cloud Serverless JDBC format:
# jdbc:mysql://<TIDB_HOST>:4000/<DB_NAME>?sslMode=VERIFY_IDENTITY&enabledTLSProtocols=TLSv1.2,TLSv1.3
# Local MySQL format:
# jdbc:mysql://localhost:3306/stress_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_URL=jdbc:mysql://gateway01.us-west-2.prod.aws.tidbcloud.com:4000/stress_db?sslMode=VERIFY_IDENTITY&enabledTLSProtocols=TLSv1.2,TLSv1.3
DB_USERNAME=your_tidb_username
DB_PASSWORD=your_tidb_password

# Optional: Connection pool tuning (defaults: max=5, min=1 for serverless/free containers)
DB_POOL_MAX=5
DB_POOL_MIN=1

# Hibernate schema strategy (default: update)
JPA_DDL_AUTO=update

# ------------------------------------------------------------------------------
# 2. Java Spring Boot Backend Configuration (Render Web Service)
# ------------------------------------------------------------------------------
PORT=8080

# Production JWT Secret: Provide a secure 64+ character random string
JWT_SECRET=your_super_secret_jwt_key_at_least_64_characters_long_for_hs256_security
JWT_EXPIRATION=86400000

# URL of the deployed Python ML Microservice (Render internal or public URL)
# Example: https://stressguard-ml-service.onrender.com
ML_SERVICE_URL=https://your-ml-service-name.onrender.com

# CORS Configuration: Comma-separated list of allowed frontend origins, or * for dev
# Example: https://your-stressguard-app.vercel.app,https://your-custom-domain.com
CORS_ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# 3. Python ML Microservice Configuration (Render Web Service)
# ------------------------------------------------------------------------------
# Port for Flask / Gunicorn (auto-assigned by Render, defaults to 5000 locally)
ML_PORT=5000

# ------------------------------------------------------------------------------
# 4. Frontend Configuration (Vercel / Netlify / Client Runtime)
# ------------------------------------------------------------------------------
# Optional overrides if you wish to inject fixed endpoints into window.APP_CONFIG
# or configure via localStorage ('api_endpoint', 'ml_endpoint')
VITE_API_BASE_URL=https://your-backend-service-name.onrender.com/api
VITE_ML_BASE_URL=https://your-ml-service-name.onrender.com
